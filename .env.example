# Local development defaults.

# Hot/read-model DB. The service writes current projections here.
IB_READ_MODEL_HOT_DATABASE_URL=postgresql://postgres:postgres@db_hot:5432/ibdb_hot

# Warm/source DB. The service writes history/audit here and reads yield_indexer.* here.
IB_READ_MODEL_WARM_DATABASE_URL=postgresql://postgres:postgres@db_warm:5432/ibdb

# Logical price entrypoint. Price data is read through this QL, not tables.
IB_READ_MODEL_PRICE_INDEXER_BASE_URL=http://host.docker.internal:3001

IB_READ_MODEL_MODEL_VERSION=price_read_model_v1
IB_READ_MODEL_DEFAULT_ASSETS=ethereum,bitcoin
IB_READ_MODEL_HTTP_TIMEOUT_SECONDS=10
IB_READ_MODEL_REFRESH_INTERVAL_SECONDS=300
