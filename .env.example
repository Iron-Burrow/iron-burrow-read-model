# Local development defaults.
#
# Locally, hot read-model projections and warm source reads can live in the
# same Postgres container. In production they can split.

# Hot/read-model DB. The service writes only to read_model.* here.
IB_READ_MODEL_DATABASE_URL=postgresql://postgres:postgres@db:5432/ibdb

# Warm/source DB. Direct source reads such as yield_indexer.* happen here.
IB_READ_MODEL_SOURCE_DATABASE_URL=postgresql://postgres:postgres@db:5432/ibdb

# Logical price entrypoint. Price data is read through this QL, not tables.
IB_READ_MODEL_PRICE_INDEXER_BASE_URL=http://host.docker.internal:3001

IB_READ_MODEL_MODEL_VERSION=price_read_model_v1
IB_READ_MODEL_DEFAULT_ASSETS=ethereum,bitcoin
IB_READ_MODEL_HTTP_TIMEOUT_SECONDS=10
IB_READ_MODEL_REFRESH_INTERVAL_SECONDS=300
