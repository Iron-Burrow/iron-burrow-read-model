# Local development defaults.
# For production configuration, see .env.prod.example

# Application environment: development, staging, or production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Hot/read-model DB. The service writes current projections here.
# Legacy aliases: IB_READ_MODEL_HOT_DATABASE_URL, IB_READ_MODEL_DATABASE_URL
HOT_DATABASE_URL=postgresql://postgres:postgres@db_hot:5432/ibdb_hot

# Warm/source DB. The service writes history/audit here and reads mother_api.* here.
# Legacy aliases: IB_READ_MODEL_WARM_DATABASE_URL, IB_READ_MODEL_SOURCE_DATABASE_URL
WARM_DATABASE_URL=postgresql://postgres:postgres@db_warm:5432/ibdb

# Price-indexer QL endpoint. Price data enters through this private API.
# Legacy aliases: IB_READ_MODEL_PRICE_INDEXER_QL_BASE_URL, IB_READ_MODEL_PRICE_INDEXER_BASE_URL
PRICE_INDEXER_QL_BASE_URL=http://iron-burrow-price-indexer:3010

# Bearer token for private price-indexer QL access (optional in development)
# Legacy aliases: PRICE_QL_INTERNAL_TOKEN, IB_READ_MODEL_PRICE_QL_INTERNAL_TOKEN
PRICE_INDEXER_QL_BEARER_TOKEN=

# Worker loop interval in seconds
# Legacy aliases: IB_READ_MODEL_RUN_INTERVAL_SECONDS, IB_READ_MODEL_REFRESH_INTERVAL_SECONDS
RUN_INTERVAL_SECONDS=300

# HTTP client configuration
HTTP_TIMEOUT_SECONDS=10

# Database connection pool configuration
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Model version identifier
MODEL_VERSION=price_read_model_v1
