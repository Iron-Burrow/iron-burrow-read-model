# Production example.

# Hot/read-model database in Neon.
# The service writes current projections only.
IB_READ_MODEL_HOT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/ibdb_hot?sslmode=require

# Warm/source IBDB on the VPS.
# The service reads indexer-owned schemas here and writes history/audit here.
IB_READ_MODEL_WARM_DATABASE_URL=postgresql://USER:PASSWORD@VPS_HOST:5432/ibdb?sslmode=require

# Price-indexer QL endpoint. Price source data must enter through this API.
IB_READ_MODEL_PRICE_INDEXER_BASE_URL=https://price-indexer.internal.example

IB_READ_MODEL_MODEL_VERSION=price_read_model_v1
IB_READ_MODEL_DEFAULT_ASSETS=ethereum,bitcoin
IB_READ_MODEL_HTTP_TIMEOUT_SECONDS=10
IB_READ_MODEL_REFRESH_INTERVAL_SECONDS=300
