# Production configuration template.
# Copy to .env.prod (gitignored) and fill in actual values.
# Do NOT commit credentials to version control.

# Application environment (required for production validation)
APP_ENV=production

# Logging level for production (INFO or WARNING recommended)
LOG_LEVEL=INFO

# Hot/read-model database in Neon or low-latency provider.
# The service writes current projections only.
# REQUIRED: Must be a non-localhost URL in production.
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/ibdb_hot?sslmode=require
HOT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/ibdb_hot?sslmode=require

# Warm/source IBDB on VPS or managed Postgres.
# The service reads mother_api.* and writes history/audit here.
# REQUIRED: Must be a non-localhost URL in production.
# Example: postgresql://user:password@vps.example.com:5432/ibdb?sslmode=require
WARM_DATABASE_URL=postgresql://USER:PASSWORD@VPS_HOST:5432/ibdb?sslmode=require

# Price-indexer QL private endpoint over iron-burrow-net.
# Price source data must enter through this authenticated API.
# REQUIRED: Set to internal Docker network hostname or private URL.
# Example: http://iron-burrow-price-indexer:3010 (internal)
# Example: https://price-indexer-ql.internal.example.com (VPN/Tailscale)
PRICE_INDEXER_QL_BASE_URL=http://iron-burrow-price-indexer:3010

# Bearer token for price-indexer QL authentication.
# REQUIRED: Shared secret for internal service-to-service auth.
# Generate with: openssl rand -base64 32
PRICE_INDEXER_QL_BEARER_TOKEN=REPLACE_WITH_SHARED_SECRET

# Worker run interval in seconds (default: 300 = 5 minutes)
RUN_INTERVAL_SECONDS=300

# HTTP client timeout for QL requests (default: 10 seconds)
HTTP_TIMEOUT_SECONDS=10

# Database connection pool sizes (optional, defaults: min=1, max=10)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Model version identifier (optional, default: price_read_model_v1)
MODEL_VERSION=price_read_model_v1
