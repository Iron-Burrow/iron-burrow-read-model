# Production example.
#
# Recommended naming:
# - Warm canonical IBDB: the VPS/Postgres database that stores indexer-owned facts.
# - Hot read-model DB: the low-latency projection database, e.g. Neon.
#
# Avoid names like "IBDB-prod" for the hot DB because that describes the
# environment, not the purpose. Prefer "ibdb_hot" or "iron_burrow_read_model_hot".

# Hot/read-model database, for example Neon.
# The service writes only to read_model.* in this database.
IB_READ_MODEL_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/ibdb_hot?sslmode=require

# Warm/source IBDB, for example the VPS database.
# The service reads indexer-owned schemas/tables from here, such as yield_indexer.*.
IB_READ_MODEL_SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@VPS_HOST:5432/ibdb?sslmode=require

# Price-indexer QL endpoint. Price source data must enter through this API.
IB_READ_MODEL_PRICE_INDEXER_BASE_URL=https://price-indexer.internal.example

IB_READ_MODEL_MODEL_VERSION=price_read_model_v1
IB_READ_MODEL_DEFAULT_ASSETS=ethereum,bitcoin
IB_READ_MODEL_HTTP_TIMEOUT_SECONDS=10
IB_READ_MODEL_REFRESH_INTERVAL_SECONDS=300
